# --- Supabase (server only: never expose the service role key to the browser) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email delivery via Resend (optional: if unset, responses are saved but no email is sent) ---
RESEND_API_KEY=
EMAIL_FROM="Money DNA <moneydna@exoasia.org>"
EMAIL_REPLY_TO=

# --- Public (baked in at build time: set these as Coolify build variables too) ---
NEXT_PUBLIC_SITE_URL=https://moneydna.exoasia.org
NEXT_PUBLIC_HERMES_URL=https://hermes.exoasia.org
NEXT_PUBLIC_PRIVACY_URL=https://exoasia.org/privacy

# Bump when the consent wording on the email screen changes (stored with each opt-in)
CONSENT_VERSION=2026-10-v1
