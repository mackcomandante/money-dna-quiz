# --- Supabase (server only: never expose the service role key to the browser) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email delivery via Resend (optional: if unset, responses are saved but no email is sent) ---
RESEND_API_KEY=
EMAIL_FROM="Money DNA <moneydna@exoasia.org>"
EMAIL_REPLY_TO=

# --- Public (baked in at build time: set these as Coolify build variables too) ---
NEXT_PUBLIC_SITE_URL=https://moneydna.exoasia.org
NEXT_PUBLIC_HERMES_URL=https://hermes.exoasia.org
NEXT_PUBLIC_PRIVACY_URL=https://exoasia.org/privacy

# Bump when the consent wording on the email screen changes (stored with each opt-in)
CONSENT_VERSION=2026-10-v1

# --- Admin dashboard at /admin (server only). Leave empty to disable the admin area. ---
ADMIN_PASSWORD=

# Four Strands game (/fourstrands): "Continue with Google" accounts.
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized JavaScript origins: https://moneydna.exoasia.org and http://localhost:3399. No redirect URIs needed.
GOOGLE_CLIENT_ID=
# Optional: signs the player session cookie (falls back to a key derived from SUPABASE_SERVICE_ROLE_KEY).
FOURSTRANDS_SESSION_SECRET=
# Local testing only: "Sign in as test player" without Google, on localhost. Never set in production.
FOURSTRANDS_DEV_LOGIN=
